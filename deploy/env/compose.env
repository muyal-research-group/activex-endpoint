# Compose interpolation values.
# Use with: docker compose --env-file deploy/env/compose.env up -d

XOLO_COMPOSE_PROJECT_NAME=xolo

XOLO_DOCKERFILE=Dockerfile
XOLO_IMAGE=nachocode/xolo:api-0.1.0a2
XOLO_APP_ENV_FILE=./deploy/env/app.prod.env
XOLO_API_CONTAINER_NAME=xolo-api
XOLO_HOST=0.0.0.0
XOLO_PORT=10000
XOLO_API_PUBLIC_PORT=10000
XOLO_UVICORN_LOG_LEVEL=info

XOLO_MONGO_IMAGE_TAG=8-noble
XOLO_MONGO_CONTAINER_NAME=xolo-mongodb
XOLO_MONGODB_PUBLIC_PORT=27018

XOLO_REDIS_IMAGE_TAG=7.0.11-alpine
XOLO_REDIS_CONTAINER_NAME=xolo-redis
XOLO_REDIS_PUBLIC_PORT=6379

XOLO_MONGO_VOLUME_NAME=xolo-mongodb-data
XOLO_REDIS_VOLUME_NAME=xolo-redis-data
XOLO_DATA_VOLUME_NAME=xolo-data
XOLO_LOG_VOLUME_NAME=xolo-logs
XOLO_BUILD_CONTEXT=../xolo-api
XOLO_MONGO_ENV_FILE=./deploy/env/mongodb.env
XOLO_REDIS_ENV_FILE=./deploy/env/redis.env

# --- shared network -----------------------------------------------------------
AXO_NETWORK_NAME=axo-net

# --- axo (axo_endpoint mesh + axo_vem) -------------------------------
AXO_ENDPOINT_DOCKERFILE=Dockerfile
AXO_ENDPOINT_IMAGE=axo-endpoint:local
AXO_ENDPOINT_ENV_FILE=.env.prod

# axo-runner pre-build (deploy.sh up --build) -- must match
# AXO_ENDPOINT_CONTAINER_RUNNER_IMAGE and the python_version your functions
# register with (see axo_endpoint/config.py's defaults).
AXO_ENDPOINT_RUNNER_IMAGE=axo-runner
AXO_ENDPOINT_RUNNER_PYTHON_VERSION=3.11

AXO_VEM_IMAGE=axo-vem:local
AXO_VEM_CONTAINER_NAME=axo-vem
AXO_VEM_ENV_FILE=./deploy/env/axo.vem.prod.env
AXO_VEM_PUBLIC_PORT=8080

AXO_KURRENTDB_IMAGE_TAG=24.10.0-jammy
AXO_KURRENTDB_CONTAINER_NAME=axo-kurrentdb
AXO_KURRENTDB_ENV_FILE=./deploy/env/axo.kurrentdb.prod.env
AXO_KURRENTDB_VOLUME_NAME=axo-kurrentdb-data

AXO_VEM_MONGO_IMAGE_TAG=7
AXO_VEM_MONGO_CONTAINER_NAME=axo-vem-mongo
AXO_VEM_MONGO_ENV_FILE=./deploy/env/axo.vem.mongodb.env
AXO_VEM_MONGO_VOLUME_NAME=axo-vem-mongo-data

