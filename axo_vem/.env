# =============================================================================
# axo_vem — base configuration (code defaults)
# Override per-environment with .env.dev; production is driven directly by
# ../deploy/env/axo.vem.prod.env via docker-compose's env_file: mechanism.
# =============================================================================

# --- ZMQ ingestion (node -> API, internal only) -------------------------------
AXO_VEM_ROUTER_BIND=tcp://0.0.0.0:6000

# --- HTTP (external, the only exposed surface) --------------------------------
AXO_VEM_HTTP_HOST=0.0.0.0
AXO_VEM_HTTP_PORT=8080

# --- Kurrent (write side / source of truth) -----------------------------------
AXO_VEM_KURRENT_URI=esdb://localhost:2113?tls=false

# --- MongoDB (read side / materialized view) ----------------------------------
AXO_VEM_MONGO_URI=mongodb://localhost:27017
AXO_VEM_MONGO_DB_NAME=axo_vem

# --- Retry/backoff for Mongo/Kurrent connection attempts ------------------------
AXO_VEM_DB_CONNECT_MAX_ATTEMPTS=10
AXO_VEM_DB_CONNECT_BASE_DELAY_SECONDS=1.0
AXO_VEM_DB_CONNECT_MAX_DELAY_SECONDS=30.0
AXO_VEM_PROJECTOR_STALE_AFTER_SECONDS=60.0

# --- Xolo (identity / access control) -------------------------------------------
AXO_VEM_XOLO_URI=http://localhost:10000/api/v4
# Deployment secrets -- must be supplied per environment, no working default.
AXO_VEM_XOLO_API_KEY=
AXO_VEM_XOLO_ACCOUNT_ID=

# --- Outbound commands (API -> node, e.g. VIRTUAL_ENV_ASSIGN) --------------------
AXO_VEM_ENDPOINT_COMMAND_TIMEOUT_SECONDS=10.0

# --- Node deployment (API -> Docker/Swarm, launching new axo_endpoint nodes) -----
AXO_VEM_NODE_IMAGE=axo-endpoint:local
AXO_VEM_NODE_NETWORK=axo-net
AXO_VEM_DOCKER_MODE=docker
AXO_VEM_NODE_API_URI=tcp://axo-vem:6000

# --- Logging -------------------------------------------------------------------
AXO_VEM_LOG_LEVEL=DEBUG
AXO_VEM_LOG_DISABLED=false
AXO_VEM_LOG_TO_FILE=false
AXO_VEM_LOG_PATH=.axo_vem/log
AXO_VEM_LOG_FILENAME=axo_vem
# Optional: override the full output path for regular logs
AXO_VEM_LOG_OUTPUT_PATH=
# Optional: override the full output path for error logs
AXO_VEM_LOG_ERROR_OUTPUT_PATH=
AXO_VEM_LOG_CONSOLE_LEVEL=DEBUG
AXO_VEM_LOG_FILE_LEVEL=DEBUG
AXO_VEM_LOG_ERROR_FILE=false
AXO_VEM_LOG_ROTATION_WHEN=midnight
AXO_VEM_LOG_ROTATION_INTERVAL=1
# JSON indent spaces (0 = compact output)
AXO_VEM_LOG_JSON_INDENT=0
AXO_VEM_LOG_USE_RICH=false
AXO_VEM_LOG_COLORIZE=true
